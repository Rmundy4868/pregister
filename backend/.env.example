# Backend server settings
PORT=3000
CORS_ORIGIN=*

# Supabase (required for batch/status operations)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Hosted Payment Page (optional; used when token is not already a URL)
HPP_CHECKOUT_BASE_URL=
HPP_TOKEN_QUERY_PARAM=authToken
HPP_AMOUNT_QUERY_PARAM=amount
HPP_REFERENCE_QUERY_PARAM=referenceId

# PaaayIT Request (feature-flagged hosted payment invoice flow)
PAAAYIT_REQUESTS_ENABLED=false
# Allowed range in code is 48-72 hours; default is 72 when omitted.
PAAAYIT_REQUESTS_DEFAULT_EXPIRY_HOURS=72
# iPOS hosted payment API base URL (without trailing endpoint path)
IPOS_HPP_API_BASE_URL=https://payment.ipospays.tech/api/v1
# JWT token for iPOS external-payment-transaction API
IPOS_HPP_API_TOKEN=
# Optional shared secret header validation for payment webhook callbacks
PAAAYIT_WEBHOOK_SECRET=

# Auto close batch scheduler (optional)
AUTO_CLOSE_BATCH_SCHEDULER_ENABLED=false
AUTO_CLOSE_BATCH_CHECK_INTERVAL_SEC=60
SPIN_AUTOCLOSE_SANDBOX=true
AUTO_CLOSE_BATCH_API_KEY=

# SMTP (required for in-app receipt email)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Optional fallback Reply-To (terminal setting can override per request)
SMTP_REPLY_TO=
