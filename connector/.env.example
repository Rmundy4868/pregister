# -----------------------------------------------------------------------------
# PaaayIT Card Reader Connector — environment configuration
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# -----------------------------------------------------------------------------

# Shared secret token between the connector and the Flutter app.
# Must match the --dart-define=CHIP_CONNECTOR_TOKEN value used in your build.
# Use a long random string in production (e.g. openssl rand -hex 32).
CONNECTOR_TOKEN=change-me-to-a-strong-secret

# Production safety gates (recommended defaults).
# CONNECTOR_STRICT_STARTUP=true causes startup to fail when preflight checks fail.
# ALLOW_INSECURE_DEV_TOKEN=true only for temporary local testing.
# CONNECTOR_REQUIRE_FULL_CONTROL=true enforces hardware session + chirp/indicator control
# for bbpos-sdk mode at startup/readiness (fails fast when unsupported).
# CONNECTOR_REQUIRE_SDK_MANAGED_FLOW=true enforces SDK-managed session path and
# fails when preflight trace indicates raw-HID fallback.
CONNECTOR_STRICT_STARTUP=true
ALLOW_INSECURE_DEV_TOKEN=false
CONNECTOR_REQUIRE_FULL_CONTROL=false
CONNECTOR_REQUIRE_SDK_MANAGED_FLOW=false

# TCP port to listen on (default 17777 — change only if there is a conflict).
PORT=17777

# Driver mode:
#   stub      — simulates card transactions (no hardware needed, for testing)
#   epn-sdk   — eProcessing Network BBPOS bridge via EpnSdkBridge.exe
#   bbpos-sdk — ePN BBPOS bridge (alias for epn-sdk)
DRIVER_MODE=stub

# Passed through to the bridge executable.
#   stub      — bridge returns simulated responses
#   bbpos-sdk — ePN BBPOS bridge mode (active)
BRIDGE_MODE=stub

# Optional bridge executable override (absolute or connector-relative path).
# BRIDGE_EXECUTABLE_PATH=EpnSdkBridge.exe

# Set to true after EpnSdkBridge.exe is deployed and ePN credentials are configured.
EPN_SDK_READY=false

# eProcessing Network credentials (for BBPOS/TDBE flow)
EPN_API_LOGIN_ID=YOUR_EPN_LOGIN_ID
EPN_USER_ID=YOUR_EPN_USER_ID
EPN_PASSWORD=YOUR_EPN_PASSWORD
EPN_RESTRICT_KEY=YOUR_EPN_RESTRICT_KEY

# Optional legacy epn-sdk fallback fields
# (used when BRIDGE_MODE=epn-sdk and the bridge needs direct gateway auth fields)
# EPN_TRANSACTION_KEY=
# EPN_ENVIRONMENT=sandbox
# EPN_TERMINAL_ID=1

# AWC Walker C3X USB HID Product ID override (hex or decimal).
# Leave blank to use the default C3X PID (0x2030).
# C3X_PRODUCT_ID=

# Optional HID overrides and tuning for plug-and-play behavior.
# CHIP_READER_VENDOR_ID=0x15A2
# CHIP_READER_PRODUCT_ID=0x0101
# CHIP_READER_MAX_CANDIDATES=2
# CHIP_READER_PER_DEVICE_TIMEOUT_SECONDS=8

# Max connector-side sale duration in ms before returning timeout.
# Default is 3 minutes to allow chip insert/tap retries without premature timeout.
SALE_TIMEOUT_MS=180000

# CORS: your production web app origin (the connector also allows all localhost origins).
ALLOWED_ORIGIN=https://pregister1.vercel.app
